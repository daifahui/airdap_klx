    "flashConfig": {
        "mcutype": "CH572D",
        "address": "0x00000000",
        "target_path": "${project}/obj/DFU.hex",
        "clkSpeed": "High",
        "debug_interface_mode": "1-wire serial",
        "erase": false,
        "program": false,
        "verify": false,
        "reset": false,
        "sdiPrintf": false,
