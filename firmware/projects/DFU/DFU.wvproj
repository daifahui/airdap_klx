{
    "version": "1.0",
    "hasAllParsed": true,
    "isNormalMRSProject": true,
    "basic": {
        "chipInfo": {
            "vendor": "WCH",
            "toolchain": "RISC-V",
            "series": "CH57x",
            "rtos": "NoneOS",
            "mcu": "CH572D",
            "description": "DFU",
            "tempratureScope": "",
            "link": "",
            "peripheral_version": "",
            "calibrateSupport": false,
            "UIConfigSupport": false,
            "externalFlashSupport": false
