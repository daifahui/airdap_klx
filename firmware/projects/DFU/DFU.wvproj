        "linkedFolders": [
            {
                "name": "99_entry",
                "location": "../../src/dfu"
            },
            {
                "name": "98_dfu",
                "location": "../../src/dfu"
            },
            {
                "name": "97_usb_control",
                "location": "../../src/dfu"
            },
            {
                "name": "96_flash_ch572",
                "location": "../../src/dfu"
            },
            {
                "name": "95_platform",
                "location": "../../src/dfu"
            },
            {
                "name": "94_boot",
                "location": "../../src/dfu"
            }
        ],
        "removedResources": [
            {
                "parentLogicPath": "",
                "type": "file",
                "name": "*.7z"
            },
            {
                "parentLogicPath": "",
                "type": "file",
                "name": "*.zip"
            },
            {
                "parentLogicPath": "",
                "type": "file",
                "name": "*.tar"
            }
        ],
        "projectName": "DFU",
        "architecture": "RISC-V",
        "projectType": "c"
    },
    "buildConfig": {
        "configurations": [
            {
                "parallelizationNumber": "disabled",
                "buildArtifact": {
                    "artifact_name": "${ProjName}",
                    "artifact_extension": "elf",
                    "output_prefix": "",
                    "artifact_type": "Executable"
                },
                "stop_on_first_build_error": true,
                "usingCacheAccelerate": false,
                "pre_script": "",
                "pre_script_description": "",
                "post_script": "\"${cross_prefix}objcopy\" -I binary -O elf32-littleriscv -B riscv --rename-section .data=.dfu_image,alloc,load,readonly,data,contents DFU.bin dfu_image.o",
                "post_script_description": "",
                "excludeResources": [
                    "${project}/99_entry/usb_control.c",
                    "${project}/99_entry/dfu_runtime.c",
                    "${project}/99_entry/dfu.c",
                    "${project}/99_entry/flash_ch572.c",
                    "${project}/99_entry/platform.c",
                    "${project}/99_entry/usb_dfu_entry.S",
                    "${project}/98_dfu/usb_control.c",
                    "${project}/98_dfu/dfu_runtime.c",
                    "${project}/98_dfu/flash_ch572.c",
                    "${project}/98_dfu/platform.c",
                    "${project}/98_dfu/entry.S",
                    "${project}/98_dfu/usb_dfu_entry.S",
                    "${project}/97_usb_control/dfu_runtime.c",
                    "${project}/97_usb_control/dfu.c",
                    "${project}/97_usb_control/flash_ch572.c",
                    "${project}/97_usb_control/platform.c",
                    "${project}/97_usb_control/entry.S",
                    "${project}/97_usb_control/usb_dfu_entry.S",
                    "${project}/96_flash_ch572/usb_control.c",
                    "${project}/96_flash_ch572/dfu_runtime.c",
                    "${project}/96_flash_ch572/dfu.c",
                    "${project}/96_flash_ch572/platform.c",
                    "${project}/96_flash_ch572/entry.S",
                    "${project}/96_flash_ch572/usb_dfu_entry.S",
                    "${project}/95_platform/usb_control.c",
                    "${project}/95_platform/dfu_runtime.c",
                    "${project}/95_platform/dfu.c",
                    "${project}/95_platform/flash_ch572.c",
                    "${project}/95_platform/entry.S",
                    "${project}/95_platform/usb_dfu_entry.S",
                    "${project}/99_entry/boot.S",
                    "${project}/98_dfu/boot.S",
                    "${project}/97_usb_control/boot.S",
                    "${project}/96_flash_ch572/boot.S",
                    "${project}/95_platform/boot.S",
                    "${project}/94_boot/usb_control.c",
                    "${project}/94_boot/dfu_runtime.c",
                    "${project}/94_boot/dfu.c",
                    "${project}/94_boot/flash_ch572.c",
                    "${project}/94_boot/platform.c",
                    "${project}/94_boot/entry.S",
                    "${project}/94_boot/usb_dfu_entry.S"
                ],
                "optimization": {
                    "level": "z",
                    "message_length": false,
                    "char_is_signed": false,
                    "function_sections": true,
                    "data_sections": true,
                    "no_common_unitialized": true,
                    "do_not_inline_functions": false,
                    "assume_freestanding_environment": false,
                    "disable_builtin": true,
                    "single_precision_constants": false,
                    "position_independent_code": false,
                    "link_time_optimizer": true,
                    "disable_loop_invariant_move": false,
                    "optimize_unused_sections_declared_as_high_code": false,
                    "code_generation_without_hardware_floating": false,
                    "use_pipelines": false,
                    "show_caret_indicating_the_column": false,
                    "calling_convention_variant": false,
                    "other_optimization_flags": "-mshorten-memrefs -mrelax -fstack-usage -fno-stack-protector"
                },
                "warnings": {
                    "check_syntax_only": false,
                    "pedantic": false,
                    "pedantic_warnings_as_errors": false,
                    "inhibit_all_warnings": false,
                    "warn_on_various_unused_elements": false,
                    "warn_on_uninitialized_variables": false,
                    "enable_all_common_warnings": true,
                    "enable_extra_warnings": true,
                    "warn_on_undeclared_global_function": false,
                    "warn_on_implicit_conversions": false,
                    "warn_if_pointer_arthmetic": false,
                    "warn_if_padding_is_included": false,
                    "warn_if_shadowed_variable": false,
                    "warn_if_suspicious_logical_ops": false,
                    "warn_if_struct_is_returned": false,
                    "warn_if_floats_are_compared_as_equal": false,
                    "generate_errors_instead_of_warnings": true,
                    "other_warning_flags": ""
                },
                "debugging": {
                    "debug_level": "default",
                    "debug_format": "default",
                    "generate_prof_information": false,
                    "generate_gprof_information": false,
                    "other_debugging_flags": ""
                },
                "assembler": {
                    "preprocessor": {
                        "use_preprocessor": true,
                        "do_not_search_system_directories": false,
